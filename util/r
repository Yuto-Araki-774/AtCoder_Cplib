#!/bin/bash
# =====================================================================
# r  コンパイル → テストケース実行
#   ./r      A.cpp をコンパイルせずに実行（前にコンパイルした a.out を使う）
#   ./r c    A.cpp をコンパイルしてから実行（c 以外でも、何か付ければコンパイルする）
#   入力: input.txt  →  出力: output.txt、デバッグ出力（cerr・debug マクロ）: debug.txt
#   コンパイル時は -DLOCAL を付けるので、テンプレートの debug(...) が有効になる
#   ACL（atcoder/）は g++ の include パスに入っている前提
#   最初に 1 回だけ: chmod +x r
# =====================================================================
cd "$(dirname "$0")" || exit 1
SRC=A.cpp
BIN=./a.out

if [ $# -ge 1 ]; then
    echo "[compile] $SRC"
    g++ -std=gnu++20 -O2 -DLOCAL -Wall -Wextra -o "$BIN" "$SRC" || { echo "[compile] エラー"; exit 1; }
fi
[ -x "$BIN" ] || { echo "a.out がない。./r c でコンパイルして"; exit 1; }
[ -f input.txt ] || touch input.txt

TIMEFORMAT='%3R'
res=$( { time { "$BIN" < input.txt > output.txt 2> debug.txt; echo "status=$?" >&2; }; } 2>&1 )
st=$(echo "$res" | sed -n 's/^status=//p')
sec=$(echo "$res" | grep -v '^status=' | tail -n 1)

if [ "$st" = 0 ]; then echo "[run] OK  ${sec} s"
else echo "[run] 実行時エラー（終了コード $st）  ${sec} s"; fi
echo "----- output.txt -----"
head -n 30 output.txt
[ "$(wc -l < output.txt)" -gt 30 ] && echo "...（続きは output.txt）"
[ -s debug.txt ] && echo "（debug.txt にデバッグ出力あり）"
exit 0
